desc:kb_Recording Clock
// @description kb_Recording Clock
// @author Kamil Baranski (kamilbaranski.com)
// @version 1.3
// @about
//   Transport-aware play/record timer. Pass-through; put on a track or master.
//   Right-click the window to set 4 colors: Play/Stop text+background, Rec text+background.
// @changelog
//   + Four selectable colors (Play/Stop and Rec, text and background)
//   + Counter keeps its value after Stop; resets only on next Play/Rec
//   + Fixed right-click menu item numbering
//   + Picker docked at the bottom, live preview (Rec colors while editing Rec)

slider1:13684944<0,16777215,1>-Play/Stop text color (packed RGB)
slider2:3421236<0,16777215,1>-Play/Stop background color (packed RGB)
slider3:3355647<0,16777215,1>-Record text color (packed RGB)
slider4:460567<0,16777215,1>-Record background color (packed RGB)

@init
ext_noinit = 1;
rec_elapsed = 0;
last_transport_state = -1;
transport_state = 0;
prev_mouse_cap = 0;
picker_open = 0;
picker_target = 0;

@gfx 360 160
// Poll keyboard so mouse modifier state is available.
key = gfx_getchar();
key == 27 ? picker_open = 0;

// Right-click opens the context menu.
right_down = (mouse_cap & 2) ? 1 : 0;
right_down && !(prev_mouse_cap & 2) ? (
  gfx_x = mouse_x;
  gfx_y = mouse_y;
  menu_choice = gfx_showmenu(">Play / Stop|Text color...|<Background color...|>Record|Text color...|<Background color...|Reset defaults");
  menu_choice == 1 ? ( picker_target = 1; picker_open = 1; );
  menu_choice == 2 ? ( picker_target = 2; picker_open = 1; );
  menu_choice == 3 ? ( picker_target = 3; picker_open = 1; );
  menu_choice == 4 ? ( picker_target = 4; picker_open = 1; );
  menu_choice == 5 ? (
    slider1 = 13684944; slider2 = 3421236;
    slider3 = 3355647; slider4 = 460567;
    sliderchange(slider1); sliderchange(slider2); sliderchange(slider3);
    sliderchange(slider4);
  );
);

// Choose the active palette values.
picker_target == 1 ? selected_color = slider1;
picker_target == 2 ? selected_color = slider2;
picker_target == 3 ? selected_color = slider3;
picker_target == 4 ? selected_color = slider4;

// While editing, preview the set being edited (Rec colors for targets 3/4).
panel_h = picker_open ? 80 : 0;
clock_h = gfx_h - panel_h;
show_rec = picker_open ? (picker_target >= 3) : (transport_state == 5);

show_rec ? (
  bg = slider4; fg = slider3; #status_text = "REC";
) : (
  bg = slider2; fg = slider1;
  transport_state == 1 ? #status_text = "PLAY";
  (transport_state == 2 || transport_state == 6) ? #status_text = "PAUSE";
  (transport_state != 1 && transport_state != 2 && transport_state != 6) ? #status_text = "STOP";
);

bg_r = (bg & 255) / 255;
bg_g = ((bg >> 8) & 255) / 255;
bg_b = ((bg >> 16) & 255) / 255;
fg_r = (fg & 255) / 255;
fg_g = ((fg >> 8) & 255) / 255;
fg_b = ((fg >> 16) & 255) / 255;

gfx_set(bg_r, bg_g, bg_b, 1);
gfx_rect(0, 0, gfx_w, clock_h);

// Format elapsed time as HH:MM:SS or d HH:MM:SS if over 24 hours.
total_seconds = floor(rec_elapsed + 0.0001);
days = floor(total_seconds / 86400);
rem_seconds = total_seconds - days * 86400;
hours = floor(rem_seconds / 3600);
minutes = floor((rem_seconds - hours * 3600) / 60);
seconds = rem_seconds - hours * 3600 - minutes * 60;

days > 0 ? (
  sprintf(#clock_text, "%dd %02d:%02d:%02d", days, hours, minutes, seconds);
) : (
  sprintf(#clock_text, "%02d:%02d:%02d", hours, minutes, seconds);
);

// Font size automatically scales based on clock area height.
font_size = max(14, floor(clock_h * 0.4));
gfx_setfont(1, "Arial", font_size, 'b');
gfx_measurestr(#clock_text, text_w, text_h);
gfx_set(fg_r, fg_g, fg_b, 1);
gfx_x = (gfx_w - text_w) * 0.5;
gfx_y = (clock_h - text_h) * 0.5 - 2;
gfx_drawstr(#clock_text);

// Small status indicator in the upper-right corner.
gfx_setfont(2, "Arial", 10, 'b');
gfx_measurestr(#status_text, status_w, status_h);
gfx_x = gfx_w - status_w - 9;
gfx_y = 7;
gfx_drawstr(#status_text);

// Compact RGB picker docked at the bottom, so the clock stays visible.
picker_open ? (
  py = clock_h;
  gfx_set(0.055, 0.055, 0.06, 1);
  gfx_rect(0, py, gfx_w, panel_h);
  gfx_set(0.88, 0.88, 0.88, 1);
  gfx_setfont(2, "Arial", 12, 'b');
  picker_target == 1 ? #title = "Play / Stop - text color";
  picker_target == 2 ? #title = "Play / Stop - background color";
  picker_target == 3 ? #title = "Record - text color";
  picker_target == 4 ? #title = "Record - background color";
  gfx_x = 10; gfx_y = py + 5; gfx_drawstr(#title);

  rr = selected_color & 255;
  gg = (selected_color >> 8) & 255;
  bb = (selected_color >> 16) & 255;
  bar_x = 28; bar_w = gfx_w - 100;
  row_r = py + 24; row_g = py + 40; row_b = py + 56;

  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_x = 10; gfx_y = row_r - 1; gfx_drawstr("R");
  gfx_x = 10; gfx_y = row_g - 1; gfx_drawstr("G");
  gfx_x = 10; gfx_y = row_b - 1; gfx_drawstr("B");

  gfx_set(0.18, 0.18, 0.18, 1);
  gfx_rect(bar_x, row_r, bar_w, 10); gfx_rect(bar_x, row_g, bar_w, 10); gfx_rect(bar_x, row_b, bar_w, 10);
  gfx_set(1, 0.12, 0.12, 1); gfx_rect(bar_x, row_r, bar_w * rr / 255, 10);
  gfx_set(0.12, 1, 0.12, 1); gfx_rect(bar_x, row_g, bar_w * gg / 255, 10);
  gfx_set(0.12, 0.35, 1, 1); gfx_rect(bar_x, row_b, bar_w * bb / 255, 10);

  // Drag/click on a component bar to change it.
  (mouse_cap & 1) && mouse_x >= bar_x - 4 && mouse_x <= bar_x + bar_w + 4 ? (
    v = max(0, min(255, floor((mouse_x - bar_x) * 255 / bar_w + 0.5)));
    mouse_y >= row_r - 3 && mouse_y <= row_r + 13 ? rr = v;
    mouse_y >= row_g - 3 && mouse_y <= row_g + 13 ? gg = v;
    mouse_y >= row_b - 3 && mouse_y <= row_b + 13 ? bb = v;
    selected_color = rr + gg * 256 + bb * 65536;
    picker_target == 1 ? ( slider1 = selected_color; sliderchange(slider1); );
    picker_target == 2 ? ( slider2 = selected_color; sliderchange(slider2); );
    picker_target == 3 ? ( slider3 = selected_color; sliderchange(slider3); );
    picker_target == 4 ? ( slider4 = selected_color; sliderchange(slider4); );
  );

  // Swatch and Done button.
  gfx_set(rr / 255, gg / 255, bb / 255, 1); gfx_rect(gfx_w - 60, py + 28, 50, 36);
  gfx_set(0.22, 0.22, 0.22, 1); gfx_rect(gfx_w - 60, py + 4, 50, 18);
  gfx_set(1, 1, 1, 1); gfx_setfont(2, "Arial", 11, 0);
  gfx_x = gfx_w - 46; gfx_y = py + 7; gfx_drawstr("Done");
  (mouse_cap & 1) && mouse_x >= gfx_w - 60 && mouse_x <= gfx_w - 10 && mouse_y >= py + 4 && mouse_y <= py + 22 ? picker_open = 0;
);

prev_mouse_cap = mouse_cap;
@block
// Transport state values: 0=stopped, 1=playing, 5=recording, 6=record-paused.
transport_state = play_state;

// Track elapsed time during both playing (1) and recording (5), resetting on fresh start.
(play_state == 1 || play_state == 5) ? (
  (last_transport_state == 0 || last_transport_state == -1) ? rec_elapsed = 0;
  srate > 0 ? rec_elapsed += samplesblock / srate;
);
last_transport_state = play_state;

