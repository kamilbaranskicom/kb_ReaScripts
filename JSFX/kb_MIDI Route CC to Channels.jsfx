desc:kb_MIDI Route CC to Channels
// @description kb_MIDI Route CC to Channels
// @author Kamil Baranski (kamilbaranski.com)
// @version 1.6
// @about
//   Copies or re-routes MIDI Control Change messages from chosen source channels to chosen
//   destination channels, so e.g. one volume / expression fader can drive several instruments
//   (strings on channels 2-4) at once. All other MIDI is untouched. Only the selected channels
//   get messages, so the MIDI bus is not flooded with 16 channels.
//
//   PARAMETER
//   Original CC       Keep original = the incoming CC passes through and copies are added.
//                     Remove original = a matching CC is NOT passed on, only sent to the
//                     destination channels (e.g. CC arrives on ch 1, goes only to ch 5, 6, 7).
//
//   GRIDS (click to toggle, click and drag to paint many at once)
//   Source channels   Channels the CC is read from (several can be selected).
//   Destination channels  Channels that receive the CC. With Keep original, a copy is never sent
//                     back to the channel the message came from (it would be a duplicate).
//   CC numbers        Which controllers are copied (0-127). Hover a cell to see the CC name,
//                     e.g. "CC 7: Channel Volume (MSB)". Buttons: "0-119" selects all real
//                     controllers (not the channel-mode messages 120-127, e.g. All Notes Off),
//                     "None" clears the grid.
//   Search           Click the search field (a blinking cursor shows it is active), then type to find CCs by name or number (e.g. "vol", "pan", "64");
//                    matches get a yellow outline. Backspace deletes, Esc clears. "Add found" /
//                    "Remove found" switch all matches on / off in one click.
//   The grid state is stored in hidden parameters, so it is saved with presets and projects.
// @changelog
//   + Search field focus with a blinking cursor (click the field to type, click elsewhere to leave)
//   + CC search by name / number, default CCs: 1, 7, 11, 64
//   + Defaults: Remove original (route), destinations 1-4
//   + Fixed wrong description of CC 0 (array overlap)
//   + Renamed from "Copy CC to Channels"; Original CC: Keep / Remove (route instead of copy)
//   + Source channels and CC numbers as clickable grids (several of each), CC names on hover
//   + Fixed mouse input
//   + Channel grid (click / drag) instead of 16 separate sliders
//   + Initial release
tags:midi cc copy channel
in_pin:none
out_pin:none

slider11:1<0,1,1{Keep original,Remove original (route)}>Original CC
slider1:1<0,65535,1>-Source channels (bit mask)
slider2:15<0,65535,1>-Destination channels (bit mask)
slider3:2178<0,65535,1>-CC 0-15 (bit mask)
slider4:0<0,65535,1>-CC 16-31 (bit mask)
slider5:0<0,65535,1>-CC 32-47 (bit mask)
slider6:0<0,65535,1>-CC 48-63 (bit mask)
slider7:1<0,65535,1>-CC 64-79 (bit mask)
slider8:0<0,65535,1>-CC 80-95 (bit mask)
slider9:0<0,65535,1>-CC 96-111 (bit mask)
slider10:0<0,65535,1>-CC 112-127 (bit mask)

@init
cc_on = 0;        // 128 flags: CC enabled
name_off = 128;   // 128 offsets into #names
name_len = 300;   // 128 lengths (name_off gets 129 entries, so keep a gap)
cc_hit = 700;      // 128 flags: CC matches the search
search_dirty = 1;
search_focus = 0;
strcpy(#search, "");
cc_words = 512;   // 8 words (must not overlap the other arrays)
src_mask = 1;
dst_mask = 15;
last_down = 0;
active_g = 0;

strcpy(#names, "");
strcat(#names, "Bank Select (MSB)|Modulation Wheel (MSB)|Breath Controller (MSB)|Undefined|Foot Controller (MSB)|Portamento Time (MSB)|Data Entry (MSB)|Channel Volume (MSB)|");
strcat(#names, "Balance (MSB)|Undefined|Pan (MSB)|Expression (MSB)|Effect Control 1 (MSB)|Effect Control 2 (MSB)|Undefined|Undefined|");
strcat(#names, "General Purpose 1 (MSB)|General Purpose 2 (MSB)|General Purpose 3 (MSB)|General Purpose 4 (MSB)|Undefined|Undefined|Undefined|Undefined|");
strcat(#names, "Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|");
strcat(#names, "Bank Select (LSB)|Modulation Wheel (LSB)|Breath Controller (LSB)|Undefined|Foot Controller (LSB)|Portamento Time (LSB)|Data Entry (LSB)|Channel Volume (LSB)|");
strcat(#names, "Balance (LSB)|Undefined|Pan (LSB)|Expression (LSB)|Effect Control 1 (LSB)|Effect Control 2 (LSB)|Undefined|Undefined|");
strcat(#names, "General Purpose 1 (LSB)|General Purpose 2 (LSB)|General Purpose 3 (LSB)|General Purpose 4 (LSB)|Undefined|Undefined|Undefined|Undefined|");
strcat(#names, "Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|");
strcat(#names, "Sustain Pedal|Portamento On/Off|Sostenuto|Soft Pedal|Legato Footswitch|Hold 2|Sound Variation|Resonance (Timbre)|");
strcat(#names, "Release Time|Attack Time|Brightness (Cutoff)|Decay Time|Vibrato Rate|Vibrato Depth|Vibrato Delay|Sound Control 10|");
strcat(#names, "General Purpose 5|General Purpose 6|General Purpose 7|General Purpose 8|Portamento Control|Undefined|Undefined|Undefined|");
strcat(#names, "High Res Velocity Prefix|Undefined|Undefined|Reverb Send|Tremolo Depth|Chorus Send|Detune (Celeste)|Phaser Depth|");
strcat(#names, "Data Increment|Data Decrement|NRPN (LSB)|NRPN (MSB)|RPN (LSB)|RPN (MSB)|Undefined|Undefined|");
strcat(#names, "Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|");
strcat(#names, "Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|");
strcat(#names, "All Sound Off|Reset All Controllers|Local Control|All Notes Off|Omni Off|Omni On|Mono On|Poly On|");

// Index the names (separated by |)
n = 0; pos = 0; name_off[0] = 0;
loop(strlen(#names),
  str_getchar(#names, pos) == 124 ? (
    name_len[n] = pos - name_off[n];
    n += 1;
    name_off[n] = pos + 1;
  );
  pos += 1;
);

function load_from_sliders()
(
  src_mask = slider1;
  dst_mask = slider2;
  cc_words[0] = slider3; cc_words[1] = slider4; cc_words[2] = slider5; cc_words[3] = slider6;
  cc_words[4] = slider7; cc_words[5] = slider8; cc_words[6] = slider9; cc_words[7] = slider10;
  k = 0;
  loop(128,
    cc_on[k] = (cc_words[floor(k / 16)] >> (k % 16)) & 1;
    k += 1;
  );
);

function save_to_sliders()
(
  w = 0;
  loop(8,
    v = 0; b = 0;
    loop(16,
      cc_on[w * 16 + b] ? v += (1 << b);
      b += 1;
    );
    cc_words[w] = v;
    w += 1;
  );
  slider1 = src_mask;
  slider2 = dst_mask;
  slider3 = cc_words[0]; slider4 = cc_words[1]; slider5 = cc_words[2]; slider6 = cc_words[3];
  slider7 = cc_words[4]; slider8 = cc_words[5]; slider9 = cc_words[6]; slider10 = cc_words[7];
  sliderchange(1023);
  slider_automate(1023);
);

function get_bit(g, i)
(
  g == 1 ? (src_mask >> i) & 1 :
  g == 2 ? (dst_mask >> i) & 1 :
  cc_on[i];
);

// returns 1 if the value actually changed
function set_bit(g, i, v)
(
  get_bit(g, i) == v ? 0 : (
    dlt = v ? (1 << i) : -(1 << i);
    g == 1 ? (src_mask += dlt;) : g == 2 ? (dst_mask += dlt;) : (cc_on[i] = v;);
    1;
  );
);

function set_all(g, v)
(
  g == 1 ? (src_mask = v ? 65535 : 0;) : g == 2 ? (dst_mask = v ? 65535 : 0;) : (
    k = 0;
    loop(128, cc_on[k] = (v && k < 120) ? 1 : 0; k += 1;);
  );
);

function grid_y(g) ( g == 1 ? 24 : g == 2 ? 76 : 172; );

function apply_found(v)
(
  k = 0;
  loop(128, cc_hit[k] ? (cc_on[k] = v;); k += 1;);
);
function grid_rh(g) ( g == 3 ? 20 : 26; );
function grid_rows(g) ( g == 3 ? 8 : 1; );

@slider
load_from_sliders();

@block
while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & $xF0;
  ch = msg1 & $x0F;       // 0-based
  hit = (status == $xB0 && ((src_mask >> ch) & 1) && cc_on[msg2 & 127]);
  remove_orig = slider11 == 1;

  (!(hit && remove_orig)) ? midisend(offset, msg1, msg2, msg3); // original passes unless routed away

  hit ? (
    d = 0;
    loop(16,
      ((remove_orig || d != ch) && ((dst_mask >> d) & 1)) ? midisend(offset, $xB0 | d, msg2, msg3);
      d += 1;
    );
  );
);

@gfx 640 362
pad = 10;
cols = 16;
cw = (gfx_w - 2 * pad) / cols;
mx = mouse_x; my = mouse_y;
mouse_down = mouse_cap & 1;

// Keyboard: type to search CCs
while ((c = gfx_getchar()) > 0) (
  !search_focus ? c = 0; // ignore keys unless the field is active
  c == 8 ? (strlen(#search) > 0 ? (strcpy_substr(#tmp, #search, 0, strlen(#search) - 1); strcpy(#search, #tmp);)) :
  c == 27 ? (strcpy(#search, "");) :
  (c >= 32 && c < 127) ? sprintf(#search, "%s%c", #search, c);
  search_dirty = 1;
);
search_dirty ? (
  search_dirty = 0;
  n_hit = 0;
  k = 0;
  loop(128,
    cc_hit[k] = 0;
    strlen(#search) > 0 ? (
      strcpy_substr(#nm, #names, name_off[k], name_len[k]);
      sprintf(#cand, "%d %s", k, #nm);
      sprintf(#pat, "*%s*", #search);
      matchi(#pat, #cand) ? (cc_hit[k] = 1; n_hit += 1;);
    );
    k += 1;
  );
);

sbtn = 0;
(my >= 128 && my < 144) ? (
  (mx >= pad + 282 && mx < pad + 362) ? sbtn = 1;
  (mx >= pad + 366 && mx < pad + 456) ? sbtn = 2;
);

// What is under the mouse?
hover_g = 0; hover_i = -1;
g = 1;
loop(3,
  gy = grid_y(g); rh = grid_rh(g);
  (mx >= pad && mx < pad + cols * cw && my >= gy && my < gy + grid_rows(g) * rh) ? (
    hover_g = g;
    hover_i = floor((my - gy) / rh) * cols + floor((mx - pad) / cw);
  );
  g += 1;
);

// Buttons (All / None) above each grid
hover_btn_g = 0; hover_btn = 0;
g = 1;
loop(3,
  by = grid_y(g) - 19;
  (my >= by && my < by + 16) ? (
    (mx >= gfx_w - pad - 104 && mx < gfx_w - pad - 54) ? (hover_btn_g = g; hover_btn = 1;);
    (mx >= gfx_w - pad - 50 && mx < gfx_w - pad) ? (hover_btn_g = g; hover_btn = 2;);
  );
  g += 1;
);

changed = 0;
(mouse_down && !last_down) ? (
  search_focus = (mx >= pad + 52 && mx < pad + 272 && my >= 128 && my < 144);
  sbtn ? (
    apply_found(sbtn == 1);
    changed = 1;
  ) : hover_btn_g ? (
    set_all(hover_btn_g, hover_btn == 1);
    changed = 1;
  ) : hover_g ? (
    active_g = hover_g;
    paint_v = get_bit(hover_g, hover_i) ? 0 : 1;
  );
);
!mouse_down ? active_g = 0;
(mouse_down && active_g && hover_g == active_g) ? (
  set_bit(active_g, hover_i, paint_v) ? changed = 1;
);
last_down = mouse_down;
changed ? save_to_sliders();

// Drawing
gfx_setfont(1, "Arial", 14);
g = 1;
loop(3,
  gy = grid_y(g); rh = grid_rh(g); rows = grid_rows(g);

  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_x = pad; gfx_y = gy - 19;
  g == 1 ? gfx_drawstr("Source channels (read CC from)") :
  g == 2 ? gfx_drawstr("Destination channels") :
  gfx_drawstr("CC numbers (hover for name)");

  // buttons
  b = 1;
  loop(2,
    bx = gfx_w - pad - (b == 1 ? 104 : 50);
    gfx_set(0.3, 0.3, 0.3, 1);
    gfx_rect(bx, gy - 19, 50 - 4, 16, 1);
    gfx_set(1, 1, 1, 1);
    sprintf(#s, "%s", b == 1 ? (g == 3 ? "0-119" : "All") : "None");
    gfx_measurestr(#s, tw, th);
    gfx_x = bx + (46 - tw) / 2; gfx_y = gy - 19 + (16 - th) / 2;
    gfx_drawstr(#s);
    b += 1;
  );

  i = 0;
  loop(rows * cols,
    cx = pad + (i % cols) * cw;
    cy = gy + floor(i / cols) * rh;
    on = get_bit(g, i);
    on ? (
      g == 1 ? gfx_set(0.25, 0.5, 0.85, 1) :
      g == 2 ? gfx_set(0.2, 0.7, 0.35, 1) :
      gfx_set(0.85, 0.55, 0.2, 1);
    ) : gfx_set(0.18, 0.18, 0.18, 1);
    gfx_rect(cx + 1, cy + 1, cw - 2, rh - 2, 1);
    (g == 3 && cc_hit[i]) ? (
      gfx_set(1, 0.9, 0.2, 1);
      gfx_rect(cx + 1, cy + 1, cw - 2, rh - 2, 0);
      gfx_rect(cx + 2, cy + 2, cw - 4, rh - 4, 0);
    );
    (g == hover_g && i == hover_i) ? (
      gfx_set(1, 1, 1, 1);
      gfx_rect(cx + 1, cy + 1, cw - 2, rh - 2, 0);
    );

    gfx_set(1, 1, 1, on ? 1 : 0.5);
    sprintf(#s, "%d", g == 3 ? i : i + 1);
    gfx_measurestr(#s, tw, th);
    gfx_x = cx + (cw - tw) / 2; gfx_y = cy + (rh - th) / 2;
    gfx_drawstr(#s);
    i += 1;
  );
  g += 1;
);

// Search row
gfx_set(0.85, 0.85, 0.85, 1);
gfx_x = pad; gfx_y = 129;
gfx_drawstr("Search:");
gfx_set(0.12, 0.12, 0.12, 1);
gfx_rect(pad + 52, 128, 220, 16, 1);
gfx_set(1, 1, 1, 1);
gfx_x = pad + 56; gfx_y = 129;
strlen(#search) > 0 ? gfx_drawstr(#search) : (gfx_set(1, 1, 1, 0.35); gfx_drawstr("type a name or number..."););
search_focus ? (
  gfx_set(0.4, 0.6, 1, 1);
  gfx_rect(pad + 52, 128, 220, 16, 0);
  (floor(time_precise() * 2) % 2 == 0) ? (
    gfx_measurestr(#search, tw, th);
    gfx_set(1, 1, 1, 1);
    gfx_rect(pad + 56 + tw + 1, 130, 1, 12, 1);
  );
);
b = 1;
loop(2,
  bx = pad + (b == 1 ? 282 : 366);
  bw = b == 1 ? 80 : 90;
  gfx_set(0.3, 0.3, 0.3, 1);
  gfx_rect(bx, 128, bw, 16, 1);
  gfx_set(1, 1, 1, 1);
  sprintf(#s, "%s", b == 1 ? "Add found" : "Remove found");
  gfx_measurestr(#s, tw, th);
  gfx_x = bx + (bw - tw) / 2; gfx_y = 129;
  gfx_drawstr(#s);
  b += 1;
);
strlen(#search) > 0 ? (
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_x = pad + 462; gfx_y = 129;
  sprintf(#s, "%d found", n_hit);
  gfx_drawstr(#s);
);

// Info line
gfx_set(0.85, 0.85, 0.85, 1);
gfx_x = pad; gfx_y = 172 + 8 * 20 + 6;
hover_g == 3 ? (
  strcpy_substr(#nm, #names, name_off[hover_i], name_len[hover_i]);
  sprintf(#info, "CC %d: %s", hover_i, #nm);
  gfx_drawstr(#info);
) : hover_g ? (
  sprintf(#info, "MIDI channel %d", hover_i + 1);
  gfx_drawstr(#info);
);
