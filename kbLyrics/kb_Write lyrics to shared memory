// @description Write lyrics to shared memory
// @author Kamil Baranski (kamilbaranski.com)
// @version 1.0
// @about
//   Writes lyrics string to shared memory for kbLyrics.
// @changelog
//   + Initial release
//@gmem=kbLyrics

#lyrics="";


function gmem_write_string(index, value) local(offset) (
  offset = 0;
  loop(strlen(value),
    gmem[index] = str_getchar(value, offset);
    offset += 1;
    index += 1;
  );
  gmem[index] = 0;
);
gmem_write_string(0, #lyrics);
